#!/usr/bin/env python3
"""keycap-focus: tells keycap which profile the focused Plasma window wants.

A KWin script (kwin-script/) calls org.keycap.Focus.Focus on the session bus with the focused
window's resource class; this service turns it into keycap's one desktop-facing message,
`Focus { profile }`, on /run/keycap/keycap.sock. Terminals get the `terminal` profile, file managers
`filemanager`, Ghostty `ghostty` (the terminal profile plus Ghostty's own split keys), every
other window `default`. keycap forgets the profile when a client leaves, so every two seconds the
connection is checked and, if it dropped (keycap restarted), reopened with the current profile.

Needs python3-gobject (Gio). Run with --dry-run to print what would be sent, without a socket.
"""

import json
import os
import socket
import sys
import warnings

# Resource classes (lower case) of terminal emulators, from Toshy's list; a name that starts
# with a part in TERMINAL_CONTAINS also counts (ghostty and Ptyxis put version or app ids in it).
TERMINALS = frozenset(
    """alacritty com.raggesilver.blackbox contour cutefish-terminal
    deepin-terminal dev.warp.warp eterm gnome-terminal gnome-terminal-server guake hyper
    io.elementary.terminal kgx kitty konsole lxterminal mate-terminal org.codeberg.dnkl.foot
    foot org.gnome.console org.gnome.terminal org.kde.konsole org.kde.yakuake
    org.wezfurlong.wezterm roxterm qterminal st sakura station tabby terminator terminology
    termite termius tilda tilix urxvt wave wezterm wezterm-gui xfce4-terminal xterm
    yakuake""".split()
)
TERMINAL_CONTAINS = ("ghostty", "ptyxis")

# Apps with a profile of their own (defaults.toml): ghostty inherits `terminal`. temor gets
# `terminal` on Plasma, not `keymap-aware`: KWin takes Super+T/W/D/V (tiles, overview, show
# desktop, clipboard), so Command as Super would not reach it, and temor's KDE keymap reads
# Command+letter as the Ctrl+Shift+letter `terminal` writes. The part is
# searched for in the resource class like TERMINAL_CONTAINS.
OWN_PROFILES = (("ghostty", "ghostty"), ("org.quire.temor", "terminal"))

# File managers, from Toshy's list: they get the `filemanager` profile.
FILE_MANAGERS = frozenset(
    """caja dde-file-manager dolphin io.elementary.files krusader
    nautilus nemo org.gnome.nautilus org.kde.dolphin org.kde.krusader pcmanfm pcmanfm-qt
    peony-qt spacefm thunar""".split()
)

SOCKET = os.path.join(os.environ.get("KEYCAP_RUNTIME_DIR", "/run/keycap"), "keycap.sock")
BUS_NAME = "org.keycap.Focus"
# The only caller of Focus: the KWin script runs inside KWin, so its calls come from the connection
# that owns this name. Any other program on the session bus is refused.
KWIN_NAME = "org.kde.KWin"
BUS_DAEMON = "org.freedesktop.DBus"
OBJECT_PATH = "/org/keycap/Focus"
INTERFACE_XML = """
<node><interface name="org.keycap.Focus">
  <method name="Focus"><arg type="s" name="resource_class" direction="in"/></method>
</interface></node>
"""


def profile_for(resource_class):
    """The keycap profile for a window's resource class."""
    name = resource_class.strip().lower()
    for part, profile in OWN_PROFILES:
        if part in name:
            return profile
    if name in TERMINALS or any(part in name for part in TERMINAL_CONTAINS):
        return "terminal"
    if name in FILE_MANAGERS:
        return "filemanager"
    return "default"


def from_kwin(sender, owner):
    """Whether a call from the bus connection `sender` comes from KWin, whose connection is `owner`
    (None when nobody owns the name)."""
    return owner is not None and sender == owner


def focus_message(profile):
    """The packet keycap reads: adjacently tagged JSON."""
    return json.dumps({"kind": "focus", "v": {"profile": profile}}, separators=(",", ":")).encode()


class Keycap:
    """One SOCK_SEQPACKET connection to keycap, reopened when it breaks."""

    def __init__(self, path=SOCKET):
        self.path = path
        self.sock = None
        self.profile = None  # none heard yet: nothing to restore after a reconnect

    def _connect(self):
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
        try:
            sock.connect(self.path)
            sock.settimeout(2)
            sock.recv(65536)  # Hello; the daemon sends it first on every connection
            sock.setblocking(False)
        except OSError:
            sock.close()
            raise
        self.sock = sock

    def _drop(self):
        if self.sock is not None:
            self.sock.close()
        self.sock = None

    def _drain(self):
        """Reads and discards Status packets so the daemon's queue never fills; notices a close."""
        while self.sock is not None:
            try:
                if not self.sock.recv(65536):
                    self._drop()
            except BlockingIOError:
                return
            except OSError:
                self._drop()

    def restore(self):
        """Reopens a dropped connection and sends the profile again; for a timer."""
        self._drain()
        if self.sock is None and self.profile is not None:
            self.send(self.profile)

    def send(self, profile):
        """Sends `Focus { profile }`, reconnecting once; returns whether it was delivered."""
        self.profile = profile
        for _ in range(2):
            try:
                self._drain()
                if self.sock is None:
                    self._connect()
                self.sock.send(focus_message(profile))
                return True
            except OSError:
                self._drop()
        return False


def main(argv):
    dry_run = "--dry-run" in argv
    keycap = Keycap()

    def on_focus(resource_class):
        profile = profile_for(resource_class)
        if dry_run:
            print(f"{resource_class!r} -> {focus_message(profile).decode()}", flush=True)
        elif not keycap.send(profile):
            print(f"keycap-focus: keycap is not reachable at {keycap.path}", file=sys.stderr, flush=True)

    # Gio's register_object is deprecated in favour of a closure-based call that is much harder to
    # read; the old one keeps working.
    warnings.filterwarnings("ignore", category=DeprecationWarning)
    import gi

    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib

    def kwin_owner(conn):
        """The unique name that owns org.kde.KWin now, or None (not running, or the bus did not answer)."""
        try:
            reply = conn.call_sync(
                BUS_DAEMON, "/org/freedesktop/DBus", BUS_DAEMON, "GetNameOwner",
                GLib.Variant("(s)", (KWIN_NAME,)), GLib.VariantType("(s)"),
                Gio.DBusCallFlags.NONE, 1000, None,
            )
        except GLib.Error:
            return None
        return reply.unpack()[0]

    def on_call(conn, sender, _path, _iface, method, params, invocation):
        if not from_kwin(sender, kwin_owner(conn)):
            invocation.return_dbus_error(
                "org.freedesktop.DBus.Error.AccessDenied", "only KWin may report the focused window"
            )
            return
        if method == "Focus":
            on_focus(params.unpack()[0])
        invocation.return_value(None)

    def on_bus(conn, _name):
        node = Gio.DBusNodeInfo.new_for_xml(INTERFACE_XML)
        conn.register_object(OBJECT_PATH, node.interfaces[0], on_call, None, None)

    if not dry_run:
        GLib.timeout_add_seconds(2, lambda: keycap.restore() or True)

    loop = GLib.MainLoop()
    lost = []

    def on_lost(*_):
        print(f"keycap-focus: {BUS_NAME} is taken by another program; exiting", file=sys.stderr, flush=True)
        lost.append(True)
        loop.quit()

    # DO_NOT_QUEUE: a program that owns the name first is not waited out and then replaced.
    Gio.bus_own_name(
        Gio.BusType.SESSION, BUS_NAME, Gio.BusNameOwnerFlags.DO_NOT_QUEUE, on_bus, None, on_lost
    )
    loop.run()
    if lost:
        sys.exit(1)


if __name__ == "__main__":
    main(sys.argv[1:])
