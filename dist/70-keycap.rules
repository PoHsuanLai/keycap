# keycap: the `input` group may write /dev/uinput, so the daemon (DynamicUser with
# SupplementaryGroups=input) can create its virtual keyboard. Install to /etc/udev/rules.d.
# `static_node` gives the node its mode before the uinput module is loaded.
KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"
