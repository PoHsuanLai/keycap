// keycap: the person at the active local session may restart keycap.service, so the desktop
// can recover a failed unit without a password. Install to /etc/polkit-1/rules.d.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    var allowed = ["restart", "start", "reset-failed"];
    if (unit === "keycap.service" && allowed.indexOf(verb) !== -1 &&
        subject.active && subject.local) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
